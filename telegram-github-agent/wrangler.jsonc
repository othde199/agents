{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "telegram-github-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [{ "name": "BOT_STATE", "class_name": "BotState" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BotState"] }],
  "vars": {
    "GITHUB_REPO": "othde199/agents",
    "GITHUB_DEFAULT_BRANCH": "main",
    "AI_MODEL": "@cf/meta/llama-3.2-1b-instruct",
    "MAX_FILE_BYTES": "120000"
  }
}

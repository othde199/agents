{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "telegram-github-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [{ "name": "BOT_STATE", "class_name": "BotState" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BotState"] }],
  "vars": {
    "GITHUB_REPO": "othde199/agents",
    "GITHUB_DEFAULT_BRANCH": "main",
    "GITHUB_CHECK_WORKFLOW": "agent-check.yml",
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "MAX_FILE_BYTES": "120000",
    "SUPABASE_URL": "https://xgwjtvzfyvfdvioquvtf.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable_ppp7w-rX3F3hsJMbC7_YcA_zhFcWy8d"
  }
}
